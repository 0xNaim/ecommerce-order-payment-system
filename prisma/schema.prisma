generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String
  role         UserRole @default(CUSTOMER)

  orders             Order[]
  idempotencyRecords IdempotencyRecord[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String?
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("BDT") @db.VarChar(3)
  isActive    Boolean @default(true)

  inventory    Inventory?
  orderItems   OrderItem[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, createdAt])
  @@map("products")
}

model Inventory {
  id                String @id @default(uuid()) @db.Uuid
  productId         String @unique @db.Uuid
  availableQuantity Int    @default(0)
  reservedQuantity  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("inventory")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @default(cuid())
  userId      String      @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("BDT") @db.VarChar(3)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]
  reservations InventoryReservation[]
  outboxEvents OutboxEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("BDT") @db.VarChar(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String        @db.VarChar(50)
  providerReference String?       @db.VarChar(255)
  idempotencyKey    String        @db.VarChar(255)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BDT") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  checkoutUrl        String?
  providerSessionKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, updatedAt])
  @@map("payments")
}

model PaymentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String             @db.VarChar(50)
  providerEventId String             @db.VarChar(255)
  paymentId       String?            @db.Uuid
  eventType       String             @db.VarChar(100)
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  processedAt     DateTime?          @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@map("payment_events")
}

model InventoryReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @db.Uuid
  productId String            @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  key            String   @db.VarChar(255)
  requestHash    String   @db.VarChar(64)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String @id @default(uuid()) @db.Uuid
  eventType     String @db.VarChar(150)
  aggregateType String @db.VarChar(100)
  aggregateId   String @db.VarChar(100)
  payload       Json

  orderId String? @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  lockedAt      DateTime? @db.Timestamptz(3)
  lockToken     String?   @db.Uuid
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  lastError     String?   @db.Text

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
